{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauri Demo",
  "version": "0.1.0",
  "identifier": "fr.example.tauridemo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Démo Tauri",
        "width": 520,
        "height": 640,
        "minWidth": 420,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxODdCNDM1RjM3MTRGMDkKUldRSlQzSHpOYlNIY1h4YTd1OVp4VDhDQ3JKK1VhcHFJQVVLTEJSNVRJenVCSlFlV056RmJza1EK",
      "endpoints": [
        "https://maj.example.fr/api/v1/update/tauri-demo/{{target}}/{{arch}}/{{current_version}}?bundle_type={{bundle_type}}"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
