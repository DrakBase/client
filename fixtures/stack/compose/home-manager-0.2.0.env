# Réglages de Home Manager sur cette machine. L'agent drakbase-stack les garde d'une version à
# l'autre et y ajoute seulement les réglages nouveaux. Après une modification :
#   sudo drakbase-stack restart home-manager

# Port de l'interface : http://<adresse de la machine>:8123
HM_PORT=8123

# Fuseau horaire du premier démarrage (ensuite : Paramètres > Général).
TZ=Europe/Paris

# 1 : lecture seule, aucune commande n'est envoyée aux appareils. 0 : Home Manager pilote les
# appareils que vous lui confiez (prises, TV…).
HM_READ_ONLY=1

# Propriétaire des données dans le volume home-manager-data (celui de l'archive macOS : 1000).
HM_UID=1000
HM_GID=1000
