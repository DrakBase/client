{
  "description": "Lecture de stack.json (docs/PROTOCOLE.md, « stack.json »). mode : source (le stack.json du projet) ou published (celui d'une archive, qui doit être celui de expect_app en expect_version, « demo » en 1.0.0 par défaut). document est sérialisé tel quel ; raw est pris comme texte. Une chaîne qui commence par @ est remplacée par le contenu du fichier de fixtures/ qu'elle désigne. expected : ok ou le code de StackError ; pour ok, les champs de check sont vérifiés.",
  "cases": [
    {
      "name": "publiée, minimale : valeurs par défaut",
      "mode": "published",
      "document": { "format": 1, "app": "demo", "version": "1.0.0", "service": "app", "public_keys": ["@keys/test-app.pub"], "images": { "app": "sha256:d812a9365b5761555d8517333f84fe8606f1f4ac82d37ac17476c55b902df23a" } },
      "expected": "ok",
      "check": { "health_timeout": 120, "rollback": "manual", "platforms": ["linux/arm64", "linux/amd64"], "trusted_keys": ["@keys/test-app.pub"], "images": ["app"] }
    },
    {
      "name": "publiée, complète",
      "mode": "published",
      "expect_version": "2.1.0-beta.3",
      "document": {
        "format": 1, "app": "demo", "version": "2.1.0-beta.3", "service": "app", "health_timeout": 300, "rollback": "safe",
        "pre_update": "backup", "min_compose_version": "2.24", "platforms": ["linux/arm/v7", "linux/arm64/v8", "linux/riscv64"],
        "public_keys": ["@keys/test-app.pub", "@keys/other-app.pub"],
        "images": { "app": "sha256:d812a9365b5761555d8517333f84fe8606f1f4ac82d37ac17476c55b902df23a", "web.ui": "sha256:ce668cf8384e58da7ab708c2b85418cbda376444e6414e2eb41ae67d57811259" }
      },
      "expected": "ok",
      "check": { "health_timeout": 300, "rollback": "safe", "platforms": ["linux/arm/v7", "linux/arm64", "linux/riscv64"], "trusted_keys": ["@keys/test-app.pub", "@keys/other-app.pub"], "images": ["app", "web.ui"] }
    },
    {
      "name": "projet, minimale",
      "mode": "source",
      "document": { "format": 1, "service": "home-manager", "pre_update": "backup", "public_keys": ["@keys/test-app.pub"] },
      "expected": "ok",
      "check": { "health_timeout": 120, "rollback": "manual", "platforms": ["linux/arm64", "linux/amd64"], "trusted_keys": ["@keys/test-app.pub"], "images": [] }
    },
    {
      "name": "projet, avec app_control",
      "mode": "source",
      "document": { "format": 1, "service": "home-manager", "app_control": "/run/drakbase", "public_keys": ["@keys/test-app.pub"] },
      "expected": "ok",
      "check": { "health_timeout": 120, "rollback": "manual", "platforms": ["linux/arm64", "linux/amd64"], "trusted_keys": ["@keys/test-app.pub"], "images": [], "app_control": "/run/drakbase" }
    },
    { "name": "app_control relatif", "mode": "source", "document": { "format": 1, "service": "app", "app_control": "run/drakbase", "public_keys": ["@keys/test-app.pub"] }, "expected": "app_control_invalid" },
    { "name": "app_control à la racine", "mode": "source", "document": { "format": 1, "service": "app", "app_control": "/", "public_keys": ["@keys/test-app.pub"] }, "expected": "app_control_invalid" },
    { "name": "app_control qui remonte", "mode": "source", "document": { "format": 1, "service": "app", "app_control": "/run/../etc", "public_keys": ["@keys/test-app.pub"] }, "expected": "app_control_invalid" },
    { "name": "app_control avec une variable que Compose interpolerait", "mode": "source", "document": { "format": 1, "service": "app", "app_control": "/run/${HOME}", "public_keys": ["@keys/test-app.pub"] }, "expected": "app_control_invalid" },
    { "name": "app_control avec une espace", "mode": "source", "document": { "format": 1, "service": "app", "app_control": "/run/drak base", "public_keys": ["@keys/test-app.pub"] }, "expected": "app_control_invalid" },
    { "name": "app_control en nombre", "mode": "source", "document": { "format": 1, "service": "app", "app_control": 1, "public_keys": ["@keys/test-app.pub"] }, "expected": "field_type" },
    { "name": "projet : app remplie par l'outil", "mode": "source", "document": { "format": 1, "app": "demo", "service": "app", "public_keys": ["@keys/test-app.pub"] }, "expected": "field_tool_only" },
    { "name": "projet : version remplie par l'outil", "mode": "source", "document": { "format": 1, "version": "1.0.0", "service": "app", "public_keys": ["@keys/test-app.pub"] }, "expected": "field_tool_only" },
    { "name": "projet : images remplies par l'outil", "mode": "source", "document": { "format": 1, "service": "app", "public_keys": ["@keys/test-app.pub"], "images": {} }, "expected": "field_tool_only" },
    { "name": "publiée sans images", "mode": "published", "document": { "format": 1, "app": "demo", "version": "1.0.0", "service": "app", "public_keys": ["@keys/test-app.pub"] }, "expected": "field_missing" },
    { "name": "publiée sans app", "mode": "published", "document": { "format": 1, "version": "1.0.0", "service": "app", "public_keys": ["@keys/test-app.pub"], "images": { "app": "sha256:d812a9365b5761555d8517333f84fe8606f1f4ac82d37ac17476c55b902df23a" } }, "expected": "field_missing" },
    { "name": "pas du JSON", "mode": "source", "raw": "format = 1", "expected": "json_invalid" },
    { "name": "pas un objet", "mode": "source", "raw": "[1]", "expected": "json_invalid" },
    { "name": "champ inconnu", "mode": "source", "document": { "format": 1, "service": "app", "public_keys": ["@keys/test-app.pub"], "healthcheck": true }, "expected": "field_unknown" },
    { "name": "format 2", "mode": "source", "document": { "format": 2, "service": "app", "public_keys": ["@keys/test-app.pub"] }, "expected": "format_unsupported" },
    { "name": "format en texte", "mode": "source", "document": { "format": "1", "service": "app", "public_keys": ["@keys/test-app.pub"] }, "expected": "field_type" },
    { "name": "sans format", "mode": "source", "document": { "service": "app", "public_keys": ["@keys/test-app.pub"] }, "expected": "field_missing" },
    { "name": "app en majuscules", "mode": "published", "document": { "format": 1, "app": "Demo", "version": "1.0.0", "service": "app", "public_keys": ["@keys/test-app.pub"], "images": { "app": "sha256:d812a9365b5761555d8517333f84fe8606f1f4ac82d37ac17476c55b902df23a" } }, "expected": "app_invalid" },
    { "name": "app d'une autre stack", "mode": "published", "document": { "format": 1, "app": "other", "version": "1.0.0", "service": "app", "public_keys": ["@keys/test-app.pub"], "images": { "app": "sha256:d812a9365b5761555d8517333f84fe8606f1f4ac82d37ac17476c55b902df23a" } }, "expected": "app_mismatch" },
    { "name": "app en nombre", "mode": "published", "document": { "format": 1, "app": 7, "version": "1.0.0", "service": "app", "public_keys": ["@keys/test-app.pub"], "images": { "app": "sha256:d812a9365b5761555d8517333f84fe8606f1f4ac82d37ac17476c55b902df23a" } }, "expected": "field_type" },
    { "name": "version non canonique", "mode": "published", "document": { "format": 1, "app": "demo", "version": "1.0", "service": "app", "public_keys": ["@keys/test-app.pub"], "images": { "app": "sha256:d812a9365b5761555d8517333f84fe8606f1f4ac82d37ac17476c55b902df23a" } }, "expected": "version_invalid" },
    { "name": "version avec métadonnées de build", "mode": "published", "document": { "format": 1, "app": "demo", "version": "1.0.0+5", "service": "app", "public_keys": ["@keys/test-app.pub"], "images": { "app": "sha256:d812a9365b5761555d8517333f84fe8606f1f4ac82d37ac17476c55b902df23a" } }, "expected": "version_invalid" },
    { "name": "autre version", "mode": "published", "document": { "format": 1, "app": "demo", "version": "1.0.1", "service": "app", "public_keys": ["@keys/test-app.pub"], "images": { "app": "sha256:d812a9365b5761555d8517333f84fe8606f1f4ac82d37ac17476c55b902df23a" } }, "expected": "version_mismatch" },
    { "name": "sans service", "mode": "source", "document": { "format": 1, "public_keys": ["@keys/test-app.pub"] }, "expected": "field_missing" },
    { "name": "service vide", "mode": "source", "document": { "format": 1, "service": "", "public_keys": ["@keys/test-app.pub"] }, "expected": "service_name_invalid" },
    { "name": "service avec une espace", "mode": "source", "document": { "format": 1, "service": "mon app", "public_keys": ["@keys/test-app.pub"] }, "expected": "service_name_invalid" },
    { "name": "service en nombre", "mode": "source", "document": { "format": 1, "service": 3, "public_keys": ["@keys/test-app.pub"] }, "expected": "field_type" },
    { "name": "health_timeout trop court", "mode": "source", "document": { "format": 1, "service": "app", "health_timeout": 5, "public_keys": ["@keys/test-app.pub"] }, "expected": "health_timeout_out_of_range" },
    { "name": "health_timeout trop long", "mode": "source", "document": { "format": 1, "service": "app", "health_timeout": 901, "public_keys": ["@keys/test-app.pub"] }, "expected": "health_timeout_out_of_range" },
    { "name": "health_timeout décimal", "mode": "source", "document": { "format": 1, "service": "app", "health_timeout": 12.5, "public_keys": ["@keys/test-app.pub"] }, "expected": "health_timeout_out_of_range" },
    { "name": "health_timeout en texte", "mode": "source", "document": { "format": 1, "service": "app", "health_timeout": "120", "public_keys": ["@keys/test-app.pub"] }, "expected": "field_type" },
    { "name": "rollback inconnu", "mode": "source", "document": { "format": 1, "service": "app", "rollback": "auto", "public_keys": ["@keys/test-app.pub"] }, "expected": "rollback_invalid" },
    { "name": "pre_update égal au service", "mode": "source", "document": { "format": 1, "service": "app", "pre_update": "app", "public_keys": ["@keys/test-app.pub"] }, "expected": "pre_update_same_as_service" },
    { "name": "pre_update invalide", "mode": "source", "document": { "format": 1, "service": "app", "pre_update": "a/b", "public_keys": ["@keys/test-app.pub"] }, "expected": "service_name_invalid" },
    { "name": "version de Compose avec un v", "mode": "source", "document": { "format": 1, "service": "app", "min_compose_version": "v2.24", "public_keys": ["@keys/test-app.pub"] }, "expected": "compose_version_invalid" },
    { "name": "version de Compose à 5 nombres", "mode": "source", "document": { "format": 1, "service": "app", "min_compose_version": "2.24.0.1.2", "public_keys": ["@keys/test-app.pub"] }, "expected": "compose_version_invalid" },
    { "name": "aucune plateforme", "mode": "source", "document": { "format": 1, "service": "app", "platforms": [], "public_keys": ["@keys/test-app.pub"] }, "expected": "platforms_count" },
    { "name": "plateforme hors de la table", "mode": "source", "document": { "format": 1, "service": "app", "platforms": ["linux/arm/v6"], "public_keys": ["@keys/test-app.pub"] }, "expected": "platform_invalid" },
    { "name": "plateforme Windows", "mode": "source", "document": { "format": 1, "service": "app", "platforms": ["windows/amd64"], "public_keys": ["@keys/test-app.pub"] }, "expected": "platform_invalid" },
    { "name": "plateforme en double", "mode": "source", "document": { "format": 1, "service": "app", "platforms": ["linux/arm64", "linux/arm64/v8"], "public_keys": ["@keys/test-app.pub"] }, "expected": "platform_duplicate" },
    { "name": "plateformes en texte", "mode": "source", "document": { "format": 1, "service": "app", "platforms": "linux/arm64", "public_keys": ["@keys/test-app.pub"] }, "expected": "field_type" },
    { "name": "sans clé", "mode": "source", "document": { "format": 1, "service": "app" }, "expected": "field_missing" },
    { "name": "aucune clé", "mode": "source", "document": { "format": 1, "service": "app", "public_keys": [] }, "expected": "public_keys_count" },
    { "name": "cinq clés", "mode": "source", "document": { "format": 1, "service": "app", "public_keys": ["@keys/test-app.pub", "@keys/other-app.pub", "@tauri/tauri-generated.pub", "@tauri/appsmarket-generated.pub", "@keys/test-app-crlf.pub"] }, "expected": "public_keys_count" },
    { "name": "clé illisible", "mode": "source", "document": { "format": 1, "service": "app", "public_keys": ["@keys/test-app.pub", "pas une clé"] }, "expected": "public_key_invalid" },
    { "name": "clé décalée d'une ligne", "mode": "source", "document": { "format": 1, "service": "app", "public_keys": ["@keys/malformed-empty-first-line.pub"] }, "expected": "public_key_invalid" },
    { "name": "même clé deux fois", "mode": "source", "document": { "format": 1, "service": "app", "public_keys": ["@keys/test-app.pub", "@keys/test-app-crlf.pub"] }, "expected": "public_key_duplicate" },
    { "name": "aucune image", "mode": "published", "document": { "format": 1, "app": "demo", "version": "1.0.0", "service": "app", "public_keys": ["@keys/test-app.pub"], "images": {} }, "expected": "images_count" },
    { "name": "images en liste", "mode": "published", "document": { "format": 1, "app": "demo", "version": "1.0.0", "service": "app", "public_keys": ["@keys/test-app.pub"], "images": ["app"] }, "expected": "field_type" },
    { "name": "nom d'image en majuscules", "mode": "published", "document": { "format": 1, "app": "demo", "version": "1.0.0", "service": "app", "public_keys": ["@keys/test-app.pub"], "images": { "App": "sha256:d812a9365b5761555d8517333f84fe8606f1f4ac82d37ac17476c55b902df23a" } }, "expected": "image_name_invalid" },
    { "name": "empreinte tronquée", "mode": "published", "document": { "format": 1, "app": "demo", "version": "1.0.0", "service": "app", "public_keys": ["@keys/test-app.pub"], "images": { "app": "sha256:d812a9365b57" } }, "expected": "digest_invalid" },
    { "name": "étiquette au lieu d'une empreinte", "mode": "published", "document": { "format": 1, "app": "demo", "version": "1.0.0", "service": "app", "public_keys": ["@keys/test-app.pub"], "images": { "app": "latest" } }, "expected": "digest_invalid" }
  ]
}
